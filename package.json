{
  "name": "aosc-mascots",
  "version": "1.0.0",
  "description": "AOSC Mascots website",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "desktop:build": "pnpm docs:build && node scripts/desktop-build.mjs",
    "desktop:update": "cd desktop && neu update",
    "desktop:run": "pnpm desktop:build && cd desktop && node ../scripts/desktop-ensure.mjs && neu run",
    "desktop:package": "pnpm desktop:build && pnpm desktop:update && cd desktop && neu build --embed-resources"
  },
  "keywords": [],
  "author": "AOSC OS Maintainers <maintainers@aosc.io>",
  "license": "CC-BY-SA-4.0",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "vitepress": "2.0.0-alpha.18"
  }
}