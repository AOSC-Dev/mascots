{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.aosc.mascots",
  "applicationName": "AOSC Mascots",
  "author": "Anthon Open Source Community",
  "description": "AOSC Mascots Documentation",
  "copyright": "© Anthon Open Source Community | aosc.io. All rights reserved.",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.open"
  ],
  "modes": {
    "window": {
      "title": "安安和同同 — AOSC 吉祥物",
      "width": 1280,
      "height": 800,
      "minWidth": 480,
      "minHeight": 320,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/logo.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true
    }
  },
  "cli": {
    "binaryName": "aosc-mascots",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}
